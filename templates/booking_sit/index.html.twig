{% extends 'base.html.twig' %}

{% block title %}BookingSit index{% endblock %}

{% block body %}
    <h1>BookingSit index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>SeatNumber</th>
                <th>Status</th>
                <th>UserName</th>
                <th>CreatedAt</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for booking_sit in booking_sits %}
            <tr>
                <td>{{ booking_sit.id }}</td>
                <td>{{ booking_sit.seatNumber }}</td>
                <td>{{ booking_sit.status }}</td>
                <td>{{ booking_sit.userName }}</td>
                <td>{{ booking_sit.createdAt ? booking_sit.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_booking_sit_show', {'id': booking_sit.id}) }}">show</a>
                    <a href="{{ path('app_booking_sit_edit', {'id': booking_sit.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_booking_sit_new') }}">Create new</a>
{% endblock %}
