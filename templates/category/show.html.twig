{% extends 'base.html.twig' %}

{% block title %}Category Details{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin-base.css') }}">
    <link rel="stylesheet" href="{{ asset('css/admin-show.css') }}">
{% endblock %}

{% block body %}
<div class="admin-container">
    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div class="logo-container">
            <img src="{{ asset('images/Brand LOGO GREY 1.2.png') }}" alt="Cinema Logo">
            <div class="logo-text">🎬 Cinema Admin</div>
        </div>
        <ul>
            <li><a href="{{ path('app_cinema_index') }}">Movies</a></li>
            <li><a href="{{ path('app_category_index') }}" class="active">Categories</a></li>
            <li><a href="{{ path('app_user_index') }}">Users</a></li>
            <li><a href="{{ path('booking') }}">Bookings</a></li>
        </ul>
    </aside>

    <!-- MAIN CONTENT -->
    <div class="main-content">
        <!-- TOP BAR -->
        <div class="topbar">
            <div class="title">Category Details</div>
            <div class="actions">
                <a href="{{ path('app_category_index') }}" class="btn btn-secondary">← Back</a>
                <a href="{{ path('logout') }}" class="btn btn-secondary">Logout</a>
            </div>
        </div>

        <!-- CATEGORY DETAILS -->
        <div class="content-body">
            <div class="movie-details-card">
                <h2>{{ category.name }}</h2>

                <div class="details-grid">
                    <div><strong>ID:</strong> {{ category.id }}</div>
                    <div><strong>Name:</strong> {{ category.name }}</div>
                    <div><strong>Description:</strong> {{ category.discription ?: '—' }}</div>
                </div>

                <div class="form-buttons">
                    <a href="{{ path('app_category_edit', {'id': category.id}) }}" class="btn btn-primary">Edit</a>

                    <form method="post" action="{{ path('app_category_delete', {'id': category.id}) }}" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this category?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ category.id) }}">
                        <button class="btn btn-del">Delete</button>
                    </form>

                    <a href="{{ path('app_category_index') }}" class="btn btn-secondary">Back</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
