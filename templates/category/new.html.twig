{% extends 'base.html.twig' %}

{% block title %}{{ form.vars.value.id ? 'Edit Category' : 'New Category' }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin-base.css') }}">
{% endblock %}

{% block body %}
<div class="admin-container">
    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div class="logo-container">
            <img src="{{ asset('images/Brand LOGO GREY 1.2.png') }}" alt="Cinema Logo">
            <div class="logo-text">🎬 Cinema Admin</div>
        </div>
        <ul>
            <li><a href="{{ path('app_cinema_index') }}">Movies</a></li>
            <li><a href="{{ path('app_category_index') }}" class="active">Categories</a></li>
            <li><a href="{{ path('app_user_index') }}">Users</a></li>
            <li><a href="{{ path('booking') }}">Bookings</a></li>
        </ul>
    </aside>

    <!-- MAIN CONTENT -->
    <div class="main-content">
        <!-- TOP BAR -->
        <div class="topbar">
            <div class="title">{{ form.vars.value.id ? 'Edit Category' : 'Add New Category' }}</div>
            <div class="actions">
                <a href="{{ path('app_category_index') }}" class="btn btn-secondary">← Back</a>
                <a href="{{ path('logout') }}" class="btn btn-secondary">Logout</a>
            </div>
        </div>

        <!-- FORM SECTION -->
        <div class="content-body">
            <div class="form-container">
                {{ form_start(form, {'attr': {'class': 'category-form', 'novalidate': 'novalidate'}}) }}

                <div class="form-group">
                    {{ form_label(form.name, 'Category Name') }}
                    {{ form_widget(form.name, {'attr': {'class': 'form-control'}}) }}
                    <div class="text-danger small">{{ form_errors(form.name) }}</div>
                </div>

                <div class="form-group">
                    {{ form_label(form.discription, 'Description') }}
                    {{ form_widget(form.discription, {'attr': {'class': 'form-control', 'rows': 4}}) }}
                    <div class="text-danger small">{{ form_errors(form.discription) }}</div>
                </div>

                <div class="form-buttons">
                    <button type="submit" class="btn btn-primary">
                        {{ form.vars.value.id ? 'Update Category' : 'Create Category' }}
                    </button>
                    <a href="{{ path('app_category_index') }}" class="btn btn-secondary">Cancel</a>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>

<!-- SCRIPT: Auto focus next input -->
<script>
document.addEventListener("DOMContentLoaded", () => {
    const inputs = document.querySelectorAll(".category-form input, .category-form textarea");
    inputs.forEach((input, index) => {
        input.addEventListener("keydown", e => {
            if (e.key === "Enter") {
                e.preventDefault();
                const next = inputs[index + 1];
                if (next) next.focus();
            }
        });
    });
});
</script>
{% endblock %}
