{% extends 'base.html.twig' %}

{% block title %}Category Management{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin-base.css') }}">
{% endblock %}

{% block body %}
<div class="admin-container">
    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="logo-container">
            <img src="{{ asset('images/Brand LOGO GREY 1.2.png') }}" alt="Admin Logo">
            <div class="logo-text">Cinema Admin</div>
        </div>
        <ul>
            <li><a href="{{ path('app_cinema_index') }}">Movies</a></li>
            <li><a href="{{ path('app_category_index') }}" class="active">Categories</a></li>
            <li><a href="{{ path('app_user_index') }}">Users</a></li>
            <li><a href="{{ path('booking') }}">Bookings</a></li>
        </ul>
    </aside>

    <!-- Main Content -->
    <div class="main-content">
        <div class="topbar">
            <div class="title">📂 Category Management</div>
            <div class="actions">
                <a href="{{ path('app_category_new') }}" class="btn btn-primary">+ Add Category</a>
                <a href="{{ path('logout') }}" class="btn btn-secondary">Logout</a>
            </div>
        </div>

        <div class="content-body">
            <div class="card">
                <h2>All Categories</h2>
                <p class="text-muted">Manage movie genres and their descriptions below.</p>

                <table class="table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Category Name</th>
                            <th>Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for category in categories %}
                        <tr>
                            <td>{{ category.id }}</td>
                            <td>{{ category.name }}</td>
                            <td>{{ category.discription|length > 50 ? category.discription[:50] ~ '...' : category.discription }}</td>
                            <td>
                                <a href="{{ path('app_category_show', {'id': category.id}) }}" class="btn btn-blue">Show</a>
                                <a href="{{ path('app_category_edit', {'id': category.id}) }}" class="btn btn-primary">Edit</a>

                                <form method="post" action="{{ path('app_category_delete', {'id': category.id}) }}" style="display:inline;" onsubmit="return confirm('Are you sure?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ category.id) }}">
                                    <button class="btn btn-del">Delete</button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="no-data">No categories found</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
