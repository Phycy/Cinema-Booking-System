<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{{ title }}</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background: #f9f9f9;
        }
        nav {
            background: #222;
            padding: 10px 20px;
        }
        nav a {
            color: #fff;
            margin-right: 15px;
            text-decoration: none;
            font-weight: bold;
        }
        nav a:hover {
            text-decoration: underline;
        }
        .container {
            padding: 20px;
        }
        h1 {
            color: #333;
        }
        .movie-list {
            list-style: none;
            padding: 0;
        }
        .movie-item {
            background: #fff;
            margin-bottom: 15px;
            padding: 15px;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        .movie-item h2 {
            margin: 0;
            color: #444;
        }
        .movie-item p {
            margin: 5px 0;
            color: #666;
        }
        .btn {
            display: inline-block;
            margin-top: 10px;
            padding: 8px 12px;
            background: #ff4444;
            color: #fff;
            border-radius: 5px;
            text-decoration: none;
        }
        .btn:hover {
            background: #cc0000;
        }
    </style>
</head>

<body>
    <!-- Navbar -->
    <nav>
        <a href="{{ path('home') }}">Home</a>
        <a href="{{ path('movies') }}">Movies</a>
        <a href="{{ path('booking')}}">Bookings</a>
        <a href="{{ path('login')}}">Login</a>
    </nav>

    <!-- Page Content -->
    <div class="container">
        <h1>{{ title }}</h1>
        <ul class="movie-list">
            {% for movie in movies %}
                <li class="movie-item">
                <h2>{{ movie.title }}</h2>
                <p>Genre: {{ movie.category ? movie.category.name : '-' }}</p>
                <p>Time: {{ movie.time ? movie.time|date('H:i') : '-' }}</p>
                <p>Date: {{ movie.date ? movie.date|date('Y-m-d') : '-' }}</p>
                <a href="{{ path('booking', { movie: movie.title, time: movie.time ? movie.time|date('H:i') : '' }) }}" class="btn">Book Now</a>
                </li>
            {% else %}
                <li>No movies found</li>
            {% endfor %}
        </ul>
    </div>
</body>
</html>
