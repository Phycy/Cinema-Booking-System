{% extends 'base.html.twig' %}

{% block title %}Movies Index{% endblock %}



{% block body %}
<header>
    <h1>🎬 Movie Library</h1>
</header>

<nav>
    <a href="{{ path('app_cinema_index') }}">Home</a>
    <a href="{{ path('app_cinema_new') }}">Add Movie</a>
</nav>

<section class="hero">
    <h2>All Movies</h2>
    <p>Manage your collection.</p>
</section>

<div class="container">
    <table class="movies-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Genre</th>
                <th>Description</th>
                <th>Time</th>
                <th>Date</th>
                <th>Duration</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for movie in movies %}
            <tr>
                <td>{{ movie.id }}</td>
                <td>{{ movie.title }}</td>
                <td>{{ movie.genre }}</td>
                <td>{{ movie.description|length > 50 ? movie.description[:50] ~ '...' : movie.description }}</td>
                <td>{{ movie.time ? movie.time|date('H:i') : '-' }}</td>
                <td>{{ movie.date ? movie.date|date('Y-m-d') : '-' }}</td>
                <td>{{ movie.duration ? movie.duration : '-' }}</td>
                <td>
                    <a href="{{ path('app_cinema_show', {'id': movie.id}) }}" class="btn btn-show">Show</a>
                    <a href="{{ path('app_cinema_edit', {'id': movie.id}) }}" class="btn btn-edit">Edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8" class="no-data">No movies found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

<footer>
    <p>&copy; 2025 Movie Library</p>
</footer>
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/movies.css') }}">
{% endblock %}
