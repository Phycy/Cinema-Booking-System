{% extends 'base.html.twig' %}

{% block title %}Movie Details{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin-base.css') }}">
    <link rel="stylesheet" href="{{ asset('css/admin-show.css') }}">
{% endblock %}

{% block body %}
<div class="admin-container">
    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div class="logo-container">
            <img src="{{ asset('images/Brand LOGO GREY 1.2.png') }}" alt="Cinema Logo">
            <div class="logo-text">🎬 Cinema Admin</div>
        </div>
        <ul>
            <li><a href="{{ path('app_cinema_index') }}" class="active">Movies</a></li>
            <li><a href="{{ path('app_category_index') }}">Categories</a></li>
            <li><a href="{{ path('app_user_index') }}">Users</a></li>
            <li><a href="{{ path('booking') }}">Bookings</a></li>
        </ul>
    </aside>

    <!-- MAIN CONTENT -->
    <div class="main-content">
        <!-- TOP BAR -->
        <div class="topbar">
            <div class="title">Movie Details</div>
            <div class="actions">
                <a href="{{ path('app_cinema_index') }}" class="btn btn-secondary">← Back</a>
                <a href="{{ path('logout') }}" class="btn btn-secondary">Logout</a>
            </div>
        </div>

        <!-- MOVIE DETAILS -->
        <div class="content-body">
            <div class="movie-details-card">
                <h2>{{ movie.title }}</h2>

                <div class="details-grid">
                    <div><strong>Genre:</strong> {{ movie.category ? movie.category.name : '—' }}</div>
                    <div><strong>Description:</strong> {{ movie.description ?: '—' }}</div>
                    <div><strong>Showtime:</strong> {{ movie.time ? movie.time|date('H:i') : '—' }}</div>
                    <div><strong>Date:</strong> {{ movie.date ? movie.date|date('Y-m-d') : '—' }}</div>
                    <div><strong>Duration:</strong> {{ movie.duration ?: '—' }} mins</div>
                </div>

                <div class="form-buttons">
                    <a href="{{ path('app_cinema_edit', {'id': movie.id}) }}" class="btn btn-primary">Edit</a>
                    {{ include('cinema/_delete_form.html.twig') }}
                    <a href="{{ path('app_cinema_index') }}" class="btn btn-secondary">Back</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
