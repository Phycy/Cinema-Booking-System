{% extends 'base.html.twig' %}

{% block title %}Show Movie{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/movies.css') }}">
{% endblock %}

{% block body %}
<div class="container my-5">
    <h1 class="text-center mb-4">Movie Details</h1>

    <div class="movie-details">
        <p><strong>Title:</strong> {{ movie.title }}</p>
        <p><strong>Genre:</strong> {{ movie.genre }}</p>
        <p><strong>Description:</strong> {{ movie.description }}</p>
        <p><strong>Time:</strong> {{ movie.time ? movie.time|date('H:i') : '-' }}</p>
        <p><strong>Date:</strong> {{ movie.date ? movie.date|date('Y-m-d') : '-' }}</p>
        <p><strong>Duration:</strong> {{ movie.duration ? movie.duration|date('H:i') : '-' }}</p>
    </div>

    <div class="form-buttons mt-4">
        <a href="{{ path('app_cinema_edit', {'id': movie.id}) }}" class="btn edit-btn">Edit</a>

        {{ include('cinema/_delete_form.html.twig') }}
        <a href="{{ path('app_cinema_index') }}" class="btn cancel-btn">Back</a>
    </div>
</div>
{% endblock %}
