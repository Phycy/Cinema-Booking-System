{% extends 'base.html.twig' %}

{% block title %}Login{% endblock %}

{% block body %}
<div class="login-container">
    <h1>🎬 Cinema Login</h1>

    {% if error %}
        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    <form method="post" class="login-form">
        <label for="inputEmail">Email</label>
        <input type="email" value="{{ last_username|default('') }}" name="email" id="inputEmail" placeholder="Enter your email" required autofocus>

        <label for="inputPassword">Password</label>
        <input type="password" name="password" id="inputPassword" placeholder="Enter your password" required>

        <div class="remember-me">
            <input type="checkbox" name="_remember_me" id="rememberMe">
            <label for="rememberMe">Remember me</label>
        </div>

        <button type="submit" class="btn-login">Sign In</button>
    </form>

    <p class="register-link">
        Don't have an account? <a href="{{ path('app_register') }}">Register here</a>
    </p>
</div>
{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('css/login.css') }}">
{% endblock %}
