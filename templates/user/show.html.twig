{% extends 'base.html.twig' %}

{% block title %}User Details{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin-base.css') }}">
    <link rel="stylesheet" href="{{ asset('css/admin-show.css') }}">
{% endblock %}

{% block body %}
<div class="admin-container">
    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div class="logo-container">
            <img src="{{ asset('images/Brand LOGO GREY 1.2.png') }}" alt="Cinema Logo">
            <div class="logo-text">Cinema Admin</div>
        </div>
        <ul>
            <li><a href="{{ path('app_cinema_index') }}">Movies</a></li>
            <li><a href="{{ path('app_category_index') }}">Categories</a></li>
            <li><a href="{{ path('app_user_index') }}" class="active">Users</a></li>
            <li><a href="{{ path('booking') }}">Bookings</a></li>
        </ul>
    </aside>

    <!-- MAIN CONTENT -->
    <div class="main-content">
        <!-- TOP BAR -->
        <div class="topbar">
            <div class="title">User Details</div>
            <div class="actions">
                <a href="{{ path('app_user_index') }}" class="btn btn-secondary">← Back</a>
                <a href="{{ path('logout') }}" class="btn btn-secondary">Logout</a>
            </div>
        </div>

        <!-- USER DETAILS -->
        <div class="content-body">
            <div class="movie-details-card">
                <h2>{{ user.email }}</h2>

                <div class="details-grid">
                    <div><strong>ID:</strong> {{ user.id }}</div>
                    <div><strong>Email:</strong> {{ user.email }}</div>
                    <div><strong>Role:</strong> {{ user.roles|join(', ') }}</div>
                </div>

                <div class="form-buttons">
                    <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn btn-primary">Edit</a>

                    <form method="post" action="{{ path('app_user_delete', {'id': user.id}) }}" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this user?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                        <button class="btn btn-del">Delete</button>
                    </form>

                    <a href="{{ path('app_user_index') }}" class="btn btn-secondary">Back</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

