{% extends 'base.html.twig' %}

{% block title %}Edit User{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin-base.css') }}">
    <link rel="stylesheet" href="{{ asset('css/movies.css') }}">
{% endblock %}

{% block body %}
<div class="admin-container">
    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div class="logo-container">
            <img src="{{ asset('images/Brand LOGO GREY 1.2.png') }}" alt="Cinema Logo">
            <div class="logo-text">Cinema Admin</div>
        </div>
        <ul>
            <li><a href="{{ path('app_cinema_index') }}">Movies</a></li>
            <li><a href="{{ path('app_category_index') }}">Categories</a></li>
            <li><a href="{{ path('app_user_index') }}" class="active">Users</a></li>
            <li><a href="{{ path('booking') }}">Bookings</a></li>
        </ul>
    </aside>

    <!-- MAIN CONTENT -->
    <div class="main-content">
        <div class="topbar">
            <div class="title">Edit User</div>
            <div class="actions">
                <a href="{{ path('app_user_index') }}" class="btn btn-secondary">← Back</a>
                <a href="{{ path('logout') }}" class="btn btn-secondary">Logout</a>
            </div>
        </div>

        <div class="content-body">
            <div class="form-container">
                {{ form_start(form, {'attr': {'class': 'user-form', 'novalidate': 'novalidate'}}) }}

                <div class="form-group">
                    {{ form_label(form.email) }}
                    {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
                    <div class="text-danger small">{{ form_errors(form.email) }}</div>
                </div>

                <div class="form-group">
                    {{ form_label(form.roles) }}
                    {{ form_widget(form.roles, {'attr': {'class': 'form-control'}}) }}
                    <div class="text-danger small">{{ form_errors(form.roles) }}</div>
                </div>

                <div class="form-group">
                    {{ form_label(form.password) }}
                    {{ form_widget(form.password, {'attr': {'class': 'form-control'}}) }}
                    <div class="text-danger small">{{ form_errors(form.password) }}</div>
                </div>

                <div class="form-buttons">
                    <button type="submit" class="btn btn-primary">Update User</button>
                    <a href="{{ path('app_user_index') }}" class="btn btn-secondary">Cancel</a>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
